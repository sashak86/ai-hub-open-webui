[Unit]
Description=OpenMuse local private module
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/openmuse/source
EnvironmentFile=%h/.config/openmuse/runtime.env
ExecStart=/usr/local/bin/node dist/apps/server/src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryHigh=640M
MemoryMax=768M
CPUQuota=100%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/openmuse/data
UMask=0077

[Install]
WantedBy=default.target
