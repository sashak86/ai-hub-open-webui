diff --git a/apps/server/src/engine/local-ollama.ts b/apps/server/src/engine/local-ollama.ts
new file mode 100644
index 0000000..b7a64b5
--- /dev/null
+++ b/apps/server/src/engine/local-ollama.ts
@@ -0,0 +1,80 @@
+/** Fixed local transport, preserving the resident model's context and keep-alive.
+ * Uses native Ollama chat because its OpenAI compatibility endpoint does not
+ * document keep_alive. No external API key, no model pull, no num_ctx mutation.
+ */
+export const localOllamaFetch: typeof fetch = async (input, init) => {
+  const request = new Request(input, init);
+  const url = new URL(request.url);
+  if (url.origin !== "http://127.0.0.1:11434" || url.pathname !== "/v1/chat/completions")
+    throw new Error("Local Ollama adapter only permits resident chat completions");
+  const body = await request.json();
+  if (body.model !== process.env.LOCAL_OLLAMA_MODEL) throw new Error("Only the configured resident model is allowed");
+  const messages = (body.messages ?? []).map((message: any) => {
+    let content = message.content ?? "";
+    if (Array.isArray(content)) {
+      if (content.some((part: any) => part.type !== "text" && part.type !== "input_text"))
+        throw new Error("This local text model does not accept image/audio input");
+      content = content.map((part: any) => part.text ?? "").join("\n");
+    }
+    const tool_calls = message.tool_calls?.map((call: any) => ({
+      ...call,
+      function: { ...call.function, arguments: typeof call.function.arguments === "string" ? JSON.parse(call.function.arguments) : call.function.arguments },
+    }));
+    return { role: message.role, content, ...(tool_calls ? { tool_calls } : {}), ...(message.name ? { tool_name: message.name } : {}) };
+  });
+  const response = await fetch("http://127.0.0.1:11434/api/chat", {
+    method: "POST", signal: request.signal,
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify({ model: body.model, messages, tools: body.tools,
+      stream: Boolean(body.stream), think: false, keep_alive: -1,
+      options: { num_predict: Math.min(body.max_tokens ?? body.max_completion_tokens ?? 1536, 4096),
+        ...(typeof body.temperature === "number" ? { temperature: body.temperature } : {}) } }),
+  });
+  if (!response.ok) return new Response(JSON.stringify({ error: { message: "Local model request failed", type: "local_model_error" } }), { status: response.status, headers: { "Content-Type": "application/json" } });
+  const id = "chatcmpl-local-" + crypto.randomUUID();
+  const created = Math.floor(Date.now() / 1000);
+  const calls = (items: any[]) => items.map((call, index) => ({
+    index, id: `call_${id}_${index}`, type: "function",
+    function: { name: call.function.name, arguments: JSON.stringify(call.function.arguments ?? {}) },
+  }));
+  if (!body.stream) {
+    const value = await response.json();
+    return new Response(JSON.stringify({ id, object: "chat.completion", created, model: body.model,
+      choices: [{ index: 0, message: { role: "assistant", content: value.message?.content ?? "", ...(value.message?.tool_calls?.length ? { tool_calls: calls(value.message.tool_calls) } : {}) }, finish_reason: value.message?.tool_calls?.length ? "tool_calls" : "stop" }],
+      usage: { prompt_tokens: value.prompt_eval_count ?? 0, completion_tokens: value.eval_count ?? 0, total_tokens: (value.prompt_eval_count ?? 0) + (value.eval_count ?? 0) } }), { headers: { "Content-Type": "application/json" } });
+  }
+  const encoder = new TextEncoder();
+  const reader = response.body!.getReader();
+  let buffered = "", hasTools = false;
+  const stream = new ReadableStream<Uint8Array>({
+    async start(controller) {
+      const send = (value: unknown) => controller.enqueue(encoder.encode("data: " + JSON.stringify(value) + "\n\n"));
+      const row = (line: string) => {
+        if (!line.trim()) return;
+        const value = JSON.parse(line);
+        if (value.error) throw new Error("Local model stream failed");
+        const delta: Record<string, unknown> = {};
+        if (value.message?.content) delta.content = value.message.content;
+        if (value.message?.tool_calls?.length) { hasTools = true; delta.tool_calls = calls(value.message.tool_calls); }
+        send({ id, object: "chat.completion.chunk", created, model: body.model,
+          choices: [{ index: 0, delta, finish_reason: value.done ? (hasTools ? "tool_calls" : "stop") : null }],
+          ...(value.done ? { usage: { prompt_tokens: value.prompt_eval_count ?? 0, completion_tokens: value.eval_count ?? 0, total_tokens: (value.prompt_eval_count ?? 0) + (value.eval_count ?? 0) } } : {}) });
+      };
+      try {
+        const decoder = new TextDecoder();
+        for (;;) {
+          const result = await reader.read();
+          if (result.done) break;
+          buffered += decoder.decode(result.value, { stream: true });
+          const lines = buffered.split("\n"); buffered = lines.pop() ?? "";
+          for (const line of lines) row(line);
+        }
+        if (buffered.trim()) row(buffered);
+        controller.enqueue(encoder.encode("data: [DONE]\n\n")); controller.close();
+      } catch (error) { controller.error(error); }
+      finally { reader.releaseLock(); }
+    },
+    cancel(reason) { return reader.cancel(reason); },
+  });
+  return new Response(stream, { headers: { "Content-Type": "text/event-stream", "Cache-Control": "no-store" } });
+};
