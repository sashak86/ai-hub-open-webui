diff --git a/tests/local-ollama.test.ts b/tests/local-ollama.test.ts
new file mode 100644
index 0000000..03ef306
--- /dev/null
+++ b/tests/local-ollama.test.ts
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { localOllamaFetch } from '../apps/server/src/engine/local-ollama.ts';
+
+test('local transport preserves keep-alive/context, converts streamed tools, and never forwards a cloud credential', async () => {
+  process.env.LOCAL_OLLAMA_MODEL = 'resident-test';
+  const original = globalThis.fetch;
+  let called = 0;
+  globalThis.fetch = async (url, init) => {
+    called++;
+    assert.equal(String(url), 'http://127.0.0.1:11434/api/chat');
+    assert.equal(new Headers(init?.headers).has('authorization'), false);
+    const native = JSON.parse(String(init?.body));
+    assert.equal(native.keep_alive, -1); assert.equal(native.think, false);
+    assert.equal('num_ctx' in native.options, false);
+    assert.deepEqual(native.messages[1].tool_calls[0].function.arguments, { query: 'hello' });
+    return new Response([
+      { message: { content: 'Ready' }, done: false },
+      { message: { tool_calls: [{ function: { name: 'list_files', arguments: {} } }] }, done: false },
+      { message: {}, done: true, prompt_eval_count: 12, eval_count: 3 },
+    ].map(v => JSON.stringify(v)+'\n').join(''));
+  };
+  try {
+    const response = await localOllamaFetch('http://127.0.0.1:11434/v1/chat/completions', { method: 'POST', headers: { authorization: 'Bearer never-forward', 'content-type': 'application/json' }, body: JSON.stringify({ model: 'resident-test', stream: true, messages: [{role:'user',content:'hello'},{role:'assistant',content:'',tool_calls:[{function:{name:'query',arguments:'{"query":"hello"}'}}]}] }) });
+    const stream = await response.text();
+    assert.match(stream, /Ready/); assert.match(stream, /list_files/); assert.match(stream, /tool_calls/); assert.match(stream, /\[DONE\]/); assert.equal(called, 1);
+  } finally { globalThis.fetch = original; }
+});
+test('local transport refuses other hosts, endpoints, models and nontext input before sending requests', async () => {
+  process.env.LOCAL_OLLAMA_MODEL = 'resident-test';
+  for (const [url, body] of [
+    ['https://example.com/v1/chat/completions', {model:'resident-test'}],
+    ['http://127.0.0.1:11434/api/pull', {model:'resident-test'}],
+    ['http://127.0.0.1:11434/v1/chat/completions', {model:'other'}],
+    ['http://127.0.0.1:11434/v1/chat/completions', {model:'resident-test',messages:[{role:'user',content:[{type:'image_url',image_url:{url:'https://example.com'}}]}]}],
+  ] as const) await assert.rejects(localOllamaFetch(url, {method:'POST',body:JSON.stringify(body)}));
+});
