PYTHONPATH=@HOME@/.local/share/voicestudio-src
CUDA_VISIBLE_DEVICES=
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMNIVOICE_DATA_DIR=@HOME@/.local/share/voicestudio-data
HF_HOME=@HOME@/.local/share/voicestudio-data/huggingface
HF_HUB_DISABLE_TELEMETRY=1
DO_NOT_TRACK=1
OMNIVOICE_PORT=8771
OMNIVOICE_ALLOWED_ORIGINS=@GATEWAY_ORIGINS@
OMNIVOICE_TTS_BACKEND=sherpa-onnx
OMNIVOICE_SHERPA_MODEL=@HOME@/.local/share/voicestudio-data/models/vits-piper-ru_RU-irina-medium
OMNIVOICE_PRELOAD_CAPTURE_ASR=0
OMNIVOICE_PRELOAD_TTS_ASR=0
OMNIVOICE_PRELOAD_WATERMARK=0
OMNIVOICE_CPU_POOL_WORKERS=1
AI_HUB_VOICE_ALLOWED_ENGINES=sherpa-onnx
AI_HUB_VOICE_ALLOW_MODEL_INSTALLS=0
OMNIVOICE_ANALYTICS_DISABLED=1
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
